        <div class="code-header">
            <span class="code-lang">C#</span>
            <button class="copy-btn" onclick="copyDemoCode()">Copy</button>
        </div>
<pre id="demo-snippet"><code class="cs">
public static async Task<string> PostJsonReques
    t<T>(string url, T payload)
{
    using var client = new HttpClient();
    var response = await client.PostAsJsonAsync(url, payload);
    response.EnsureSuccessStatusCode();
    return await response.Content.ReadAsStringAsync();
}
// PostJsonRequest.cs
// Sends a POST request with a JSON payload and returns the response string.

</code></pre>
