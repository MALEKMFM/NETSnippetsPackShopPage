    <link rel="canonical" href="https://techmsh.gumroad.com/l/netsnippetpack?_gl=1*12anfxf*_ga*MTg1OTA1NTQyNy4xNzQ2MjIyMDAw*_ga_6LJN6D94N6*czE3NDY2NTI4MzMkbzgkZzEkdDE3NDY2NTI4MzQkajAkbDAkaDA." />
    <meta property="og:title" content=".NET Productivity Snippet Pack — Supercharge Your .NET Coding">
    <meta property="og:description" content="Curated, reusable C# snippets for .NET developers. Boost productivity, reduce errors, and ship faster.">
    <meta property="og:image" content="https://public-files.gumroad.com/oospwifzo2mrrztu43cryazwe2ab">
    <meta property="og:url" content="https://techmsh.gumroad.com/l/netsnippetpack?_gl=1*12anfxf*_ga*MTg1OTA1NTQyNy4xNzQ2MjIyMDAw*_ga_6LJN6D94N6*czE3NDY2NTI4MzMkbzgkZzEkdDE3NDY2NTI4MzQkajAkbDAkaDA.">
    <link rel="icon" type="image/png" href="/assets/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <link rel="shortcut icon" href="/assets/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="SnippetForge" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website">
    <script type="application/ld+json">
        {
          "context": "https://schema.org/",
          "type": "Product",
          "name": ".NET Productivity Snippet Pack",
          "image": [
            "https://yourdomain.com/path-to-your-main-product-image.png"
          ],
          "description": "Curated pack of reusable, high-quality C# code snippets for .NET developers. Accelerate API, auth, data, and more.",
          "brand": {
            "type": "Brand",
            "name": "YourBrand"
          },
          "offers": {
            "type": "Offer",
            "url": "https://yourdomain.com/",
            "priceCurrency": "USD",
            "price": "19",
            "availability": "https://schema.org/InStock"
          }
        }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NETSnippetsPackShopPage</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="path/to/font-awesome/css/font-awesome.min.css">
    <link href="https://fonts.googleapis.com/css?family=Noto+Sans:400,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/NETSnippetsPackShopPage.styles.css" asp-append-version="true" />
    <style>
        body {
            font-family: 'Not', Arial, Helvrtica, sans-serif;
        }

        h1, h2, h3 {
            font-family: 'Noto Sans', Arial, Helvetica, sans-serif;
            font-weight: 700;
        }
    </style>
</head>

<body>
    <!-- Sticky Buy Now Button at Top, Hidden by Default -->
    <a href="https://your-gumroad-link.com/" target="_blank"
       class="sticky-buy-btn" id="sticky-buy-btn">
        <i class="fas fa-shopping-cart" aria-label="Buy Now"></i>
        I Want This! – $10
    </a>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">NETSnippetsPackShopPage</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - NETSnippetsPackShopPage - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
                document.addEventListener("DOMContentLoaded", function () {
            var btn = document.getElementById('sticky-buy-btn');

            function toggleStickyBtn() {
                if (window.scrollY > 457) {
                    btn.classList.add('animate-in');
                } else {
                    btn.classList.remove('animate-in');
                }
            }

            window.addEventListener('scroll', toggleStickyBtn);

            // Optional: make sure state is correct if page loads scrolled down
            toggleStickyBtn();
        });
        // document.addEventListener("DOMContentLoaded", function() {
        //   var btn = document.getElementById('sticky-buy-btn');
        //   // var isVisible = false;
        //   window.addEventListener('scroll', function() {
        //     if (window.scrollY > 455) {
        //         if(!btn.classList.contains('animate-in')){
        //             btn.classList.add('animate-in');
        //             // isVisible = true;
        //             console.log("ss");
        //         }
        //     } else {
        //          if(btn.classList.contains('animate-in')){
        //              btn.classList.remove('animate-in');
        //              // isVisible = false;
        //          }         
        //     }
        //   });
        // });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
